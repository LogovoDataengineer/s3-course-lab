{
  "name": "S3 course",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2.17.0": {},
    "ghcr.io/devcontainers/features/sshd:1.1.0": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [19001],
  "portsAttributes": {
    "19001": { "label": "MinIO Console", "onAutoForward": "notify" },
    "19000": { "label": "S3 API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "mkdir -p ~/.local/bin && pip install --user -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
